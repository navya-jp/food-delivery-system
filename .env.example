# ==========================================
# FOOD DELIVERY & KITCHEN MANAGEMENT SYSTEM
# Environment Configuration
# ==========================================

# System Environment
NODE_ENV=development
PORT_GATEWAY=8080

# Service Internal Ports
PORT_AUTH=4001
PORT_RESTAURANT=4002
PORT_ORDER=4003
PORT_KITCHEN=4004
PORT_PAYMENT=4005
PORT_DELIVERY=4006
PORT_NOTIFICATION=4007
PORT_FRONTEND=3000

# Service URLs (for API Gateway Routing)
# In Docker, these point to service hostnames
AUTH_SERVICE_URL=http://auth-service:4001
RESTAURANT_SERVICE_URL=http://restaurant-service:4002
ORDER_SERVICE_URL=http://order-service:4003
KITCHEN_SERVICE_URL=http://kitchen-service:4004
PAYMENT_SERVICE_URL=http://payment-service:4005
DELIVERY_SERVICE_URL=http://delivery-service:4006
NOTIFICATION_SERVICE_URL=http://notification-service:4007

# For Local Development (outside Docker)
LOCAL_AUTH_SERVICE_URL=http://localhost:4001
LOCAL_RESTAURANT_SERVICE_URL=http://localhost:4002
LOCAL_ORDER_SERVICE_URL=http://localhost:4003
LOCAL_KITCHEN_SERVICE_URL=http://localhost:4004
LOCAL_PAYMENT_SERVICE_URL=http://localhost:4005
LOCAL_DELIVERY_SERVICE_URL=http://localhost:4006
LOCAL_NOTIFICATION_SERVICE_URL=http://localhost:4007

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=food_delivery_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres_password@postgres:5432/food_delivery_db

# Redis Cache & Rate Limiting
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# RabbitMQ Message Broker
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# Safety switches
# Docker must use the real services. Set true ONLY for `npm run start:local` (no Docker, in-memory stores).
ALLOW_IN_MEMORY_FALLBACK=false
# Honour X-Forwarded-For for rate limiting. Keep false except while running load tests.
TRUST_PROXY=false

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_food_delivery_system_2026
JWT_EXPIRES_IN=24h

# Rate Limiter Settings (Token Bucket)
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_RATE=5
RATE_LIMIT_WINDOW_SECONDS=60

# Circuit Breaker Settings
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=8000
